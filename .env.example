# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA suba o arquivo ".env" para o GitHub (adicione ao .gitignore).

# Qual "motor" de IA os agentes vão usar: "gemini" (gratuito) ou "anthropic" (pago)
AI_PROVIDER=gemini

# GRATUITO — gere em https://aistudio.google.com/apikey (sem cartão de crédito)
GEMINI_API_KEY=sua-chave-gemini-aqui

# Opcional — só necessário se AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Opcional: aumenta o limite de requisições na NVD (gratuito, cadastro simples)
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Porta do ZAP em modo daemon. Padrão 8090 (8080/8085 costumam ser do DefectDojo)
ZAP_PROXY=http://localhost:8090

# Só necessário se usar a flag --defectdojo
DEFECTDOJO_URL=http://localhost:8080/api/v2
DEFECTDOJO_API_TOKEN=
DEFECTDOJO_PRODUCT_NAME=ASPM com IA - Tomahawks
DEFECTDOJO_PRODUCT_TYPE_NAME=Challenge Pride 2026
